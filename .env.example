# ORB Confluence Bot — Environment Variables Template
# ====================================================
# Copy this file to /etc/orb_bot.env on your droplet.
# Fill in your real values. NEVER commit the filled version.
#
# Usage: sudo nano /etc/orb_bot.env

# ----------------------------------------------------------
# TELEGRAM (get from @BotFather)
# ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ----------------------------------------------------------
# WEEX FUTURES API
# ----------------------------------------------------------
WEEX_API_KEY=your_weex_api_key_here
WEEX_SECRET_KEY=your_weex_secret_key_here

# ----------------------------------------------------------
# OPTIONAL OVERRIDES (safe defaults are set in config.py)
# ----------------------------------------------------------
# DAILY_RISK_BUDGET_USD=1.0     # Total USD risked per day across all coins
# WEEX_BASE_URL=https://api.weex.com
# LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
